# ── Publisheur ─────────────────────────────────────────────────────────
# Local SQLite stores (the cloud app uses Supabase, not these)
*.db
*.db-wal
*.db-shm

# Secrets — NEVER commit (DB password, service_role key, etc.)
.env
.env.*

# Local-only dev login helper (has test creds) — never publish
web/_devlogin.html

# Python
__pycache__/
*.pyc
.venv/

# Published output (generated by the Scribus publisher)
publish/out/

# Local Claude settings
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp

# NOTE: web/config.js IS committed on purpose — the Supabase anon key is
# public by design, and Row-Level Security (supabase/schema.sql) is what
# protects your data. Do NOT put the service_role key in config.js.

# Cloudflare wrangler local state
.wrangler/
*.code-workspace

# e2e failure screenshots
tests/e2e/_failures/
